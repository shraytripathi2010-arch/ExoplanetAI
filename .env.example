# ExoplanetAI -- environment variables.
# Copy to .env for local shell use, or set these in the launchd plist's
# EnvironmentVariables for the supervised service. NEVER commit real values.
#
# The launchd plist is the authoritative source for the running service;
# .env is only a convenience for running app.py by hand.

# REQUIRED. Signs the Flask session that carries the CSRF token. The app
# REFUSES TO START without it unless EXOPLANET_DEBUG=1. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))" > ~/.config/exoplanetai/secret_key && chmod 600 ~/.config/exoplanetai/secret_key
EXOPLANET_SECRET_KEY=REPLACE_ME_64_HEX_CHARS

# Optional, development only. "1" enables the Werkzeug debugger AND permits a
# random per-process secret key. Never set this on the supervised service: the
# debugger exposes an interactive console on any unhandled exception.
EXOPLANET_DEBUG=0

# Optional. Port the Flask app binds on (loopback only). Default 5050.
PORT=5050

# Optional. NASA ADS token for the literature cross-check. job_runner runs
# IN-PROCESS inside the Flask app, so this must be present in the app's own
# environment. Leave empty to skip the ADS lookup.
ADS_API_KEY=

# Optional. Per-star MAST download timeout in seconds, used by
# code/06_download_unknown.py. Leave unset for the built-in default.
EXOPLANETAI_DOWNLOAD_TIMEOUT=
