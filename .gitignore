# Raw and processed light curve data -- large, regeneratable via the
# pipeline scripts (01_download_known.py, 06_download_unknown.py, etc.),
# not source. This is the reason the original push never completed: ~67GB
# of this was baked into the one commit with no .gitignore in place.
data/known_lightcurves/
data/known_lightcurves_negative/
data/unknown_lightcurves/
data/unknown_lightcurves_widesector/
data/processed/
data/processed_negative/
data/processed_unknown/
data/processed_unknown_widesector/
data/retrain_pipeline/

# Kepler pilot's own raw/processed downloads (same reasoning) -- the
# pilot's scripts and small result CSVs stay tracked.
code/kepler_pilot/raw/
code/kepler_pilot/processed/

# Mutable application state, not source -- changes on every Update run,
# should never be version-controlled like a live database dump.
web/exoplanet_candidates.db
web/exoplanet.db

# Regenerated logs and on-demand plot images.
web/job_logs/

# Scheduler log + heartbeat: live operational state of one machine's running
# app, rotated on disk. Useful for watching an unattended run, meaningless in
# version control (and the heartbeat rewrites every 60s).
web/logs/
web/static/plots/

# Bootstrap uncertainty ensemble -- 32 refits of the production model, ~150MB.
# Deterministically regenerable from code/09_build_bootstrap_ensemble.py
# (fixed seeds 1000+i on the frozen training split), so it is a build artifact
# rather than source. best_model.joblib IS tracked because it is the deployed
# model and cannot be reproduced without its original tuning run; these can.
# Committing them would more than double the repo for something a single
# command rebuilds.
models/bootstrap_ensemble/

# Experiment run logs and bulky intermediate feature tables. The SCRIPTS that
# produce them and the small JSON/CSV RESULT files are tracked -- those are the
# findings. These are the raw byproducts, regenerable by re-running the script.
code/experiments/*.log
code/kepler_pilot/*.log
code/experiments/training_with_new_features.csv
# Merged feature table for the multi-sector centroid retrain: training.csv
# left-joined with the centroid results, rebuilt in seconds by
# retrain_with_centroid_multisector.py. The RESULTS (the .json) and the
# per-star measurements (training_centroid_results_multisector.csv) are
# tracked; this join is not.
code/experiments/training_with_centroid_multisector.csv

# Python bytecode cache.
__pycache__/
*.pyc

# OS junk files.
.DS_Store

# K2 pilot light curves -- same rationale as above: 35 MB, regeneratable by
# code/k2_pilot/select_and_download_k2.py. The derived features, the sample
# manifest, the logs and the JSON results ARE tracked, so the measurement is
# reproducible without the bulk data.
code/k2_pilot/raw/
code/k2_pilot/processed/

# fit cache for calibration_holdout_sweep.py -- reproducible, ~1MB, not a result
code/experiments/calibration_holdout_raw.json
code/experiments/*.json.partial
